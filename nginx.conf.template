server {
    listen 80;
    server_name ${SERVER_NAME};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    server_tokens off;

    # Security headers for every response (pages, assets and /api). Locations
    # below must not use add_header, or nginx drops these for that location.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    # Sign-up / reset links carry their token in the path; never leak it in Referer.
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), payment=()" always;

    root /usr/share/nginx/html;
    index index.html;

    access_log  /var/log/nginx/access.log;
    error_log   /var/log/nginx/error.log;

    # Inject env vars into env-config.js at request time via sub_filter
    location ~ env-config\.js$ {
        gzip off;
        sub_filter '{{API_URL}}' '${API_URL}';
        sub_filter '{{FRONTEND_URL}}' '${FRONTEND_URL}';
        sub_filter '{{APP_VERSION}}' '${APP_VERSION}';
        sub_filter '{{GOOGLE_CLIENT_ID}}' '${GOOGLE_CLIENT_ID}';
        sub_filter_once off;
        sub_filter_types application/javascript text/plain;
        expires epoch;
    }

    # PWA files must not be cached — browsers need to check for updates on every load
    location ~ ^/(sw\.js|manifest\.json|registerSW\.js|workbox-.+\.js)$ {
        expires epoch;
        try_files $uri =404;
    }

    # Serve static assets; fall back to index.html for client-side routing
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy /api/* to backend (strips /api/ prefix)
    location /api/ {
        proxy_pass ${BACKEND_URL}/;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        send_timeout 60s;
    }
}
